{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "rootDir": "./",
    "outDir": "../dist",
    "baseUrl": ".",
    "composite": true,
    "preserveConstEnums": true,
    "paths": {
      "#lib/*": ["./lib/*"],
      "#mafia/*": ["./lib/mafia/*"],
      "#util/*": ["./lib/util/*"]
    }
  },
  "include": ["."]
}